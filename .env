# ============================================
# Prisma Database URLs (PostgreSQL via Supabase)
# ============================================
#
# IMPORTANT: Choose the correct URL based on your environment:
#
# Option A: Direct connection (from Supabase internal network / local dev with VPN)
# NOTE: Port 5432 direct is blocked from this sandbox — use Option B below instead.
# DATABASE_URL=postgresql://postgres:Aiman0122769500@db.xknkgtuctjmkpommcxfd.supabase.co:5432/postgres
# DIRECT_URL=postgresql://postgres:Aiman0122769500@db.xknkgtuctjmkpommcxfd.supabase.co:5432/postgres
#
# Option B: Connection pooler (from external hosts) — ACTIVE, required for sandbox access
# Verified working 2026-06-17: region is aws-1-ap-southeast-1 (NOT aws-0-)
DATABASE_URL=postgresql://postgres.xknkgtuctjmkpommcxfd:Aiman0122769500@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xknkgtuctjmkpommcxfd:Aiman0122769500@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
#
# Option C: Session mode pooler (for Prisma migrations) - uncomment if Option B doesn't work
# DATABASE_URL=postgresql://postgres.xknkgtuctjmkpommcxfd:Aiman0122769500@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# DIRECT_URL=postgresql://postgres.xknkgtuctjmkpommcxfd:Aiman0122769500@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ============================================
