// SnapJe - Hyper-Local Food Flash Deal App
// Database Schema - Phase 1 MVP

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // NOTE: Sandbox exports a system-level DATABASE_URL=file:...sqlite that overrides .env.
  // Using PRISMA_* env var names avoids the collision. See env.md for details.
  url       = env("PRISMA_DATABASE_URL")
  directUrl = env("PRISMA_DIRECT_URL")
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  phone         String?
  avatarUrl     String?
  roles         String   @default("foodie") // comma-separated: "foodie,vendor,admin"
  activeRole    String   @default("foodie")
  emailVerified Boolean  @default(false)
  isBanned      Boolean  @default(false)
  vipFlag       Boolean  @default(false) // VIP vendor flag — gates broadcast feature
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  vendor              Vendor?
  orders              Order[]
  notifications       Notification[]
  refreshTokens       RefreshToken[]
  subscriptions       Subscription[]
  vendorSubscriptions VendorSubscription[]
  mediaFiles          MediaFile[]

  @@index([email])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

// ============================================
// VENDOR
// ============================================

model Vendor {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName      String
  description       String?
  contactEmail      String
  contactPhone      String
  address           String
  latitude          Float
  longitude         Float
  operatingHours    String   @default("{}") // JSON: { mon: "9-18", tue: "9-18", ... }
  foodCategories    String   @default("[]") // JSON array: ["Malay", "Chinese", "Indian"]
  logoUrl           String?
  coverImageUrl     String?
  verificationDocs  String   @default("[]") // JSON array of doc URLs
  verificationStatus String  @default("pending") // pending, approved, rejected, suspended
  rejectionReason   String?
  verifiedAt        DateTime?
  subscriptionPlan  String   @default("none") // none, basic, premium
  subscriptionStatus String  @default("inactive") // inactive, active, past_due, cancelled
  subscriptionStart DateTime?
  subscriptionEnd   DateTime?
  rating            Float    @default(0)
  totalSales        Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  deals                Deal[]
  orders               Order[]
  vendorSubscriptions  VendorSubscription[]
  scheduledBroadcasts  ScheduledBroadcast[]

  @@index([verificationStatus])
  @@index([latitude, longitude])
}

// ============================================
// DEALS
// ============================================

model Deal {
  id              String   @id @default(cuid())
  vendorId        String
  vendor          Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  title           String
  description     String
  category        String   // Malay, Chinese, Indian, Western, Japanese, Korean, Vegan, Dessert, Beverage, Other
  imageUrl        String?
  originalPrice   Float
  dealPrice       Float
  discountPercent Int      // auto-calculated
  totalQuantity   Int
  reservedQuantity Int     @default(0)
  soldQuantity    Int      @default(0)
  availableQuantity Int    // computed: total - reserved - sold
  maxClaimsPerUser Int    @default(1)
  status          String   @default("active") // draft, active, paused, sold_out, expired, cancelled
  pickupOnly      Boolean  @default(true)
  pickupInstructions String?
  earlyAccessAt   DateTime? // Phase 2: First Dibs
  publicAccessAt  DateTime  // when deal becomes visible to all
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  reservations Reservation[]
  orders       Order[]

  @@index([vendorId])
  @@index([vendorId, status])
  @@index([status])
  @@index([expiresAt])
  @@index([category])
  @@index([publicAccessAt])
}

// ============================================
// RESERVATIONS (Temporary claim locks)
// ============================================

model Reservation {
  id             String   @id @default(cuid())
  dealId         String
  deal           Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  userId         String
  quantity       Int      @default(1)
  status         String   @default("pending") // pending, confirmed, expired, cancelled
  expiresAt      DateTime
  // Task 2: foodie-selected pickup time (chosen at claim, copied to Order at confirm).
  // Nullable for backward compat with pre-existing reservations.
  pickupDeadline DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([dealId, status])
  @@index([dealId, userId, status])
  @@index([userId])
  @@index([expiresAt])
}

// ============================================
// ORDERS
// ============================================

model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendorId        String
  vendor          Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  dealId          String
  deal            Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  quantity        Int      @default(1)
  originalPrice   Float
  dealPrice       Float
  totalPrice      Float
  status          String   @default("pending_pickup") // pending_pickup, picked_up, completed, cancelled, expired
  qrCode          String   @unique
  qrVerifiedAt    DateTime?
  pickupDeadline  DateTime
  // Issue 8: tracks the last time a pickup-reminder notification was sent.
  // The reminder scheduler in realtime-service reads this to ensure reminders
  // fire at most every 30 minutes (not on every tick).
  lastReminderSentAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([vendorId])
  @@index([vendorId, status])
  @@index([status])
  @@index([qrCode])
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String   // deal_sold_out, deal_expiring, claim_confirmed, pickup_reminder, vendor_approved, vendor_rejected, siren_push
  title      String
  message    String
  data       String   @default("{}") // JSON: dealId, vendorId, etc.
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

// ============================================
// SUBSCRIPTIONS (Phase 2 prep)
// ============================================

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      String   // first_dibs, vendor_basic, vendor_premium
  status    String   @default("active") // active, cancelled, expired
  startDate DateTime @default(now())
  endDate   DateTime
  autoRenew Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// ============================================
// MEDIA FILE TRACKING (for Media Monitoring dashboard)
// ============================================

model MediaFile {
  id           String   @id @default(cuid())
  fileName     String
  filePath     String   // full path in SnapJe bucket: {group}/{userId}/{timestamp}_{rand}.{ext}
  publicUrl    String   // full public URL
  bucketName   String   @default("SnapJe")
  group        String   // profile, vendor_logo, vendor_banner, deal, notification
  mimeType     String
  fileSize     Int      // bytes
  width        Int?
  height       Int?
  variantKey   String?  // null for original; 'avatar', 'thumb', 'medium', etc. for variants
  uploaderId   String?
  uploader     User?    @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  alertLevel   String   @default("none") // none, info (baby blue), warning (orange), critical (red)
  createdAt    DateTime @default(now())

  @@index([group])
  @@index([uploaderId])
  @@index([alertLevel])
  @@index([fileSize])
}

// ============================================
// VENDOR SUBSCRIPTIONS (foodie follows a vendor)
// ============================================
// A foodie subscribes to a vendor to receive that vendor's broadcast
// notifications. One row per (userId, vendorId) pair — enforced by the
// @@unique constraint. Vendors and admins are excluded from receiving
// broadcasts (see /api/vendors/[id]/broadcast route).
model VendorSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, vendorId])
  @@index([userId])
  @@index([vendorId])
}

// ============================================
// SCHEDULED BROADCASTS
// ============================================
// A VIP vendor schedules a broadcast for automatic future execution.
// The scheduler (runs in the realtime-service mini-service) polls every
// 60s for rows where status='pending' AND scheduledAt <= now, executes
// them (fans out notifications to subscribers), and marks them 'sent'.
//
// Constraints enforced at the API layer:
//   - scheduledAt must be <= now + 5 days
//   - only 1 scheduled broadcast per (vendorId, DATE(scheduledAt))
model ScheduledBroadcast {
  id             String   @id @default(cuid())
  vendorId       String
  vendor         Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  // Issue 6: optional title for the broadcast notification (supports emojis).
  title          String?
  message        String
  dealId         String?
  scheduledAt    DateTime
  status         String   @default("pending") // pending, sent, cancelled
  createdAt      DateTime @default(now())
  sentAt         DateTime?
  recipientCount Int      @default(0)

  @@index([vendorId])
  @@index([status, scheduledAt])
}
